# Copy to .env. The real .env is gitignored.
# Use the same random value in main/voice_satellite_secrets.h.
SATELLITE_TOKEN=replace-with-a-long-random-token

# Dedicated signed Open WebUI session token and chat for the voice-satellite
# service user. receiver/provision_openwebui.py generates both from inside the
# Open WebUI container.
OPENWEBUI_API_KEY=replace-with-openwebui-service-token
OPENWEBUI_CHAT_ID=voice-satellite-service-chat
